<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lab_background"
    tools:context=".chat.ChatActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarChat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/lab_primary"
        app:contentInsetStartWithNavigation="0dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <!-- Logo UTEQ: placa blanca redondeada porque el PNG trae fondo blanco sólido (sin
                 transparencia); así se integra sobre el verde del header sin verse como un
                 recorte. Presencia secundaria y discreta, BioTec sigue siendo el protagonista. -->
            <ImageView
                android:layout_width="75dp"
                android:layout_height="26dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_logo_chip"
                android:contentDescription="@string/uteq_logo_desc"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/uteqlogo" />

            <FrameLayout
                android:layout_width="58dp"
                android:layout_height="58dp">

                <View
                    android:id="@+id/viewPulsoNexoBio"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:alpha="0"
                    android:background="@drawable/bg_nexobio_pulso" />

                <ImageView
                    android:id="@+id/imageNexoBioAvatar"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_nexobio_avatar"
                    android:contentDescription="@string/nexobio_nombre"
                    android:padding="11dp"
                    android:src="@drawable/ic_nexobio_robot" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nexobio_nombre"
                    android:textColor="@color/white"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nexobio_subtitulo"
                    android:textColor="@color/lab_header_subtitle"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <LinearLayout
        android:id="@+id/cardEquipoSeleccionado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_context_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbarChat"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_equipo_seleccionado_label"
                android:textColor="@color/lab_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/textNombreEquipoContexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lab_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Autoclave de vapor de mesa" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonCambiarEquipo"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/chat_cambiar_equipo"
            android:textSize="12sp"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            app:iconTint="@color/lab_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelSinApiKey"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_banner_warning"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cardEquipoSeleccionado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chat_sin_api_key"
            android:textColor="@color/lab_warning" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonIrAConfiguracion"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="@string/chat_ir_a_configuracion" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/panelSinApiKey"
        app:layout_constraintBottom_toTopOf="@id/textEstadoAsistente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textEstadoAsistente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp"
        android:textColor="@color/lab_text_secondary"
        android:textSize="13sp"
        android:textStyle="italic"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/panelEntrada"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Escuchando…"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/panelEntrada"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/lab_surface"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/botonCamara"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_camara"
            android:src="@drawable/ic_camera"
            app:tint="@color/lab_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:minHeight="42dp"
            android:paddingHorizontal="14dp">

            <EditText
                android:id="@+id/editTextPregunta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:background="@android:color/transparent"
                android:hint="@string/chat_input_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:paddingVertical="10dp"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/botonMicrofono"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_mic_button"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_microfono"
            android:src="@drawable/ic_mic"
            app:tint="@color/mic_icon_tint" />

        <ImageButton
            android:id="@+id/botonEnviar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_nexobio_avatar"
            android:contentDescription="@string/chat_enviar"
            android:padding="9dp"
            android:src="@drawable/ic_send"
            app:tint="@color/white" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
