<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lab_background"
    tools:context=".areas.EquipoDetalleActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarEquipoDetalle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/lab_primary"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollEquipoDetalle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/toolbarEquipoDetalle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/textNombreEquipoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/lab_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Autoclave" />

            <TextView
                android:id="@+id/textAreaEquipoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/lab_secondary"
                android:textSize="14sp"
                tools:text="Área de microbiología" />

            <TextView
                android:id="@+id/chipDatoDemoDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_banner_warning"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="@string/equipo_dato_demo"
                android:textColor="@color/lab_warning"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textClaseDetector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/lab_text_secondary"
                android:textSize="12sp"
                tools:text="Clase del detector: autoclave" />

            <include layout="@layout/section_divider" />

            <TextView
                style="@style/EquipoSeccionTitulo"
                android:text="@string/equipo_funcion" />
            <TextView
                android:id="@+id/textFuncion"
                style="@style/EquipoSeccionCuerpo"
                tools:text="Esterilización de material e insumos." />

            <TextView
                style="@style/EquipoSeccionTitulo"
                android:text="@string/equipo_componentes" />
            <TextView
                android:id="@+id/textComponentes"
                style="@style/EquipoSeccionCuerpo"
                tools:text="Cámara de presión, manómetro." />

            <TextView
                style="@style/EquipoSeccionTitulo"
                android:text="@string/equipo_procedimiento" />
            <TextView
                android:id="@+id/textProcedimiento"
                style="@style/EquipoSeccionCuerpo"
                tools:text="Cargar el material y seleccionar el ciclo." />

            <TextView
                style="@style/EquipoSeccionTitulo"
                android:text="@string/equipo_epp" />
            <TextView
                android:id="@+id/textEpp"
                style="@style/EquipoSeccionCuerpo"
                tools:text="Guantes térmicos, gafas de protección." />

            <TextView
                style="@style/EquipoSeccionTitulo"
                android:text="@string/equipo_riesgos" />
            <TextView
                android:id="@+id/textRiesgos"
                style="@style/EquipoSeccionCuerpo"
                tools:text="Quemaduras por vapor." />

            <TextView
                style="@style/EquipoSeccionTitulo"
                android:text="@string/equipo_practicas" />
            <TextView
                android:id="@+id/textPracticas"
                style="@style/EquipoSeccionCuerpo"
                tools:text="Esterilización de medios de cultivo." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonPreguntarAsistente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="@string/equipo_preguntar_asistente"
                app:icon="@drawable/ic_chat" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
