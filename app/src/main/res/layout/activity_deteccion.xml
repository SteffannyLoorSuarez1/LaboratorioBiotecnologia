<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".camera.DeteccionActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDeteccion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/lab_primary_dark"
        app:title="@string/deteccion_title"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/contenedorCamara"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarDeteccion"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.uteq.sofware.deteccindeequiposlaboratoriodebiotecnologa.camera.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/panelPermiso"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/lab_primary_dark"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/textMensajePermiso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/deteccion_permiso_requerido"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonConcederPermiso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/deteccion_conceder_permiso" />
        </LinearLayout>

        <TextView
            android:id="@+id/bannerModeloPendiente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/lab_warning_bg"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="@string/deteccion_modelo_pendiente"
            android:textColor="@color/lab_warning"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_warning"
            app:drawableTint="@color/lab_warning" />

        <!-- Modo selección (solo visible cuando ChatActivity abre esta pantalla con
             DeteccionActivity.EXTRA_MODO_SELECCION=true): al abrirse normalmente desde el resto
             de la app este banner queda GONE y el comportamiento no cambia. La selección real es
             tocar directamente el bounding box en OverlayView (ver
             OverlayView.habilitarSeleccionTactil) — sin botón, para no limitar a "una sola
             detección seleccionable" cuando puede haber varias simultáneas. -->
        <TextView
            android:id="@+id/bannerModoSeleccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/lab_context_card_bg"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/deteccion_modo_seleccion_hint"
            android:textColor="@color/lab_text_primary"
            android:textSize="13sp"
            android:visibility="gone" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
