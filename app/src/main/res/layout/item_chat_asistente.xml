<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/imageAvatarMensaje"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_nexobio_avatar"
        android:contentDescription="@string/nexobio_nombre"
        android:padding="6dp"
        android:src="@drawable/ic_nexobio_robot" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="28dp"
        android:background="@drawable/bg_chat_bubble_assistant"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/textMensajeAsistente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/lab_text_primary"
            android:textSize="15sp"
            tools:text="El autoclave se usa para esterilizar material mediante vapor a presión." />

        <LinearLayout
            android:id="@+id/contenedorFuentes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="8dp"
                android:background="@color/lab_context_card_border" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chat_fuentes"
                android:textColor="@color/lab_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textFuentesAsistente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/lab_text_secondary"
                android:textSize="12sp"
                tools:text="• manual_autoclave.pdf — pág. 4" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/botonEscuchar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_escuchar"
            android:src="@drawable/ic_volume_up"
            app:tint="@color/lab_primary" />

    </LinearLayout>
</LinearLayout>
