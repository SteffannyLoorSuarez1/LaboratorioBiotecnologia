<?xml version="1.0" encoding="utf-8"?>
<!--
    Pareja de ic_nexobio_robot.xml con la boca abierta (óvalo), usada por NexoBioAnimador para
    alternar boca cerrada/abierta mientras TextToSpeech está reproduciendo una respuesta (estado
    HABLANDO). No es lip-sync: es una animación ligera de boca abriéndose y cerrándose en bucle
    mientras dura el habla real (ver UtteranceProgressListener en TextToSpeechManager). Si
    reemplazas el diseño del robot, actualiza este archivo junto con ic_nexobio_robot.xml e
    ic_nexobio_robot_blink.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-4">

        <!-- antena -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M11.3,2.6 H12.7 V5.6 H11.3 Z" />
        <path
            android:fillColor="#F5A623"
            android:pathData="M10.5,1.9 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0 Z" />

        <!-- cabeza -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M6,5.6 H18 A3,3 0 0 1 21,8.6 V16.4 A3,3 0 0 1 18,19.4 H6 A3,3 0 0 1 3,16.4 V8.6 A3,3 0 0 1 6,5.6 Z" />

        <!-- ojo izquierdo + brillo -->
        <path
            android:fillColor="#1B5E3C"
            android:pathData="M6.65,11.6 a1.85,1.85 0 1,0 3.7,0 a1.85,1.85 0 1,0 -3.7,0 Z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M7.17,11.05 a0.58,0.58 0 1,0 1.16,0 a0.58,0.58 0 1,0 -1.16,0 Z" />

        <!-- ojo derecho + brillo -->
        <path
            android:fillColor="#1B5E3C"
            android:pathData="M13.65,11.6 a1.85,1.85 0 1,0 3.7,0 a1.85,1.85 0 1,0 -3.7,0 Z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M14.17,11.05 a0.58,0.58 0 1,0 1.16,0 a0.58,0.58 0 1,0 -1.16,0 Z" />

        <!-- boca abierta (óvalo), da la sensación de estar pronunciando la respuesta -->
        <path
            android:fillColor="#1B5E3C"
            android:pathData="M10.3,15.7 a1.7,1.15 0 1,0 3.4,0 a1.7,1.15 0 1,0 -3.4,0 Z" />
    </group>
</vector>
