<?xml version="1.0" encoding="utf-8"?>
<!--
    Pareja de ic_nexobio_robot.xml con un guiño (ojo izquierdo cerrado, como en
    ic_nexobio_robot_blink.xml; ojo derecho abierto normal). Usada ocasionalmente por
    NexoBioAnimador como variante del parpadeo — mucho menos frecuente, ver
    NexoBioAnimador#programarSiguienteGesto(). Mantiene la misma sonrisa que el resto de
    variantes NORMAL. Si reemplazas el diseño del robot, actualiza este archivo junto con
    ic_nexobio_robot.xml, ic_nexobio_robot_blink.xml e ic_nexobio_robot_talk.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-4">

        <!-- antena -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M11.3,2.6 H12.7 V5.6 H11.3 Z" />
        <path
            android:fillColor="#F5A623"
            android:pathData="M10.5,1.9 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0 Z" />

        <!-- cabeza -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M6,5.6 H18 A3,3 0 0 1 21,8.6 V16.4 A3,3 0 0 1 18,19.4 H6 A3,3 0 0 1 3,16.4 V8.6 A3,3 0 0 1 6,5.6 Z" />

        <!-- ojo izquierdo cerrado (guiño) -->
        <path
            android:fillColor="#1B5E3C"
            android:pathData="M6.95,11.32 H10.05 A0.28,0.28 0 0 1 10.33,11.6 A0.28,0.28 0 0 1 10.05,11.88 H6.95 A0.28,0.28 0 0 1 6.67,11.6 A0.28,0.28 0 0 1 6.95,11.32 Z" />

        <!-- ojo derecho abierto + brillo -->
        <path
            android:fillColor="#1B5E3C"
            android:pathData="M13.65,11.6 a1.85,1.85 0 1,0 3.7,0 a1.85,1.85 0 1,0 -3.7,0 Z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M14.17,11.05 a0.58,0.58 0 1,0 1.16,0 a0.58,0.58 0 1,0 -1.16,0 Z" />

        <!-- sonrisa -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#1B5E3C"
            android:strokeWidth="1.3"
            android:strokeLineCap="round"
            android:pathData="M8.8,15.3 Q12,17.6 15.2,15.3" />
    </group>
</vector>
