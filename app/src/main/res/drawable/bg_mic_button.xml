<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del botón de micrófono: círculo relleno solo mientras escucha
     (ver ImageButton.setActivated en ChatActivity). -->
<selector xmlns:android="http://schemas.android.com/res/android">
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/lab_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
