<?xml version="1.0" encoding="utf-8"?>
<!--
    Rostro de BioTec (rostro de robot amigable, ojos abiertos, boca cerrada — estado NORMAL /
    ESCUCHANDO / PENSANDO). Vector local ligero (sin dependencias externas): si se reemplaza el
    diseño, mantener el mismo nombre y viewport, y actualizar junto con él
    ic_nexobio_robot_blink.xml (parpadeo) e ic_nexobio_robot_talk.xml (boca abierta, hablando) —
    no hace falta tocar layouts ni código Java.
    <group> aplica una ligera inclinación (-4°) para dar personalidad ("cabeza ladeada, curiosa")
    sin necesidad de animarla. La punta de la antena usa el color de acento (ámbar) como pequeño
    indicador luminoso, un guiño tecnológico/de laboratorio.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-4">

        <!-- antena -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M11.3,2.6 H12.7 V5.6 H11.3 Z" />
        <!-- indicador luminoso (ámbar), pequeño detalle tecnológico en la punta de la antena -->
        <path
            android:fillColor="#F5A623"
            android:pathData="M10.5,1.9 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0 Z" />

        <!-- cabeza -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M6,5.6 H18 A3,3 0 0 1 21,8.6 V16.4 A3,3 0 0 1 18,19.4 H6 A3,3 0 0 1 3,16.4 V8.6 A3,3 0 0 1 6,5.6 Z" />

        <!-- ojo izquierdo (más grande y expresivo) + brillo -->
        <path
            android:fillColor="#1B5E3C"
            android:pathData="M6.65,11.6 a1.85,1.85 0 1,0 3.7,0 a1.85,1.85 0 1,0 -3.7,0 Z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M7.17,11.05 a0.58,0.58 0 1,0 1.16,0 a0.58,0.58 0 1,0 -1.16,0 Z" />

        <!-- ojo derecho + brillo -->
        <path
            android:fillColor="#1B5E3C"
            android:pathData="M13.65,11.6 a1.85,1.85 0 1,0 3.7,0 a1.85,1.85 0 1,0 -3.7,0 Z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M14.17,11.05 a0.58,0.58 0 1,0 1.16,0 a0.58,0.58 0 1,0 -1.16,0 Z" />

        <!-- sonrisa: expresión predeterminada, amigable -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#1B5E3C"
            android:strokeWidth="1.3"
            android:strokeLineCap="round"
            android:pathData="M8.8,15.3 Q12,17.6 15.2,15.3" />
    </group>
</vector>
