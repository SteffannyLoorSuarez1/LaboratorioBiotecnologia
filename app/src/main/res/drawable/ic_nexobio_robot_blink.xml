<?xml version="1.0" encoding="utf-8"?>
<!--
    Pareja de ic_nexobio_robot.xml con los ojos cerrados (línea fina en vez de círculo), usada
    brevemente por NexoBioAnimador para simular un parpadeo natural (ver "parpadeo ocasional" en
    estado NORMAL). Si reemplazas el diseño del robot, actualiza este archivo a la vez para que
    el parpadeo siga encajando con el nuevo diseño.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-4">

        <!-- antena -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M11.3,2.6 H12.7 V5.6 H11.3 Z" />
        <path
            android:fillColor="#F5A623"
            android:pathData="M10.5,1.9 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0 Z" />

        <!-- cabeza -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M6,5.6 H18 A3,3 0 0 1 21,8.6 V16.4 A3,3 0 0 1 18,19.4 H6 A3,3 0 0 1 3,16.4 V8.6 A3,3 0 0 1 6,5.6 Z" />

        <!-- ojos cerrados: línea fina redondeada -->
        <path
            android:fillColor="#1B5E3C"
            android:pathData="M6.95,11.32 H10.05 A0.28,0.28 0 0 1 10.33,11.6 A0.28,0.28 0 0 1 10.05,11.88 H6.95 A0.28,0.28 0 0 1 6.67,11.6 A0.28,0.28 0 0 1 6.95,11.32 Z" />
        <path
            android:fillColor="#1B5E3C"
            android:pathData="M13.95,11.32 H17.05 A0.28,0.28 0 0 1 17.33,11.6 A0.28,0.28 0 0 1 17.05,11.88 H13.95 A0.28,0.28 0 0 1 13.67,11.6 A0.28,0.28 0 0 1 13.95,11.32 Z" />

        <!-- sonrisa: se mantiene también mientras parpadea -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#1B5E3C"
            android:strokeWidth="1.3"
            android:strokeLineCap="round"
            android:pathData="M8.8,15.3 Q12,17.6 15.2,15.3" />
    </group>
</vector>
