<?xml version="1.0" encoding="utf-8"?>
<!--
    BioTec de cuerpo entero (estado NORMAL/ESCUCHANDO/PENSANDO: ojos abiertos, sonrisa, boca
    cerrada) para la pantalla de conversación por voz (VozAsistenteActivity). Vector local, sin
    dependencias externas ni Lottie (mismo criterio que ic_nexobio_robot.xml, ver
    NexoBioAnimador). La cabeza reutiliza EXACTAMENTE el mismo diseño/proporciones/colores que
    ic_nexobio_robot.xml (mismas coordenadas, solo desplazadas +1 en X para centrar en un
    viewport más ancho): cambiar uno sin el otro los desalinearía visualmente como "la misma
    marca con dos caras distintas".
    <p>
    Cuerpo añadido: torso en forma de bata de laboratorio (blanco) con cuello en V (verde),
    insignia de pecho (ámbar, hace eco de la antena), brazos tipo cápsula a los lados y una base
    redondeada en vez de piernas mecánicas — deliberadamente sin articulaciones ni piezas
    "robóticas" visibles para que se sienta amigable y no intimidante.
    <p>
    Si se reemplaza el diseño, actualizar junto con ic_biotec_full_blink.xml (parpadeo),
    ic_biotec_full_wink.xml (guiño) e ic_biotec_full_talk.xml (boca abierta, hablando).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="130dp"
    android:height="200dp"
    android:viewportWidth="26"
    android:viewportHeight="40">

    <!-- base (sin piernas mecánicas: una peana redondeada, más amigable). Relleno blanco plano
         (el degradado blanco->menta que se probó aquí quedaba casi del mismo tono que el nuevo
         fondo degradado de VozAsistenteActivity y el cuerpo prácticamente desaparecía sobre él
         — corregido volviendo al blanco sólido de siempre, que si tiene contraste real). -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M11,33 H15 A2,2 0 0 1 17,35 V36 A2,2 0 0 1 15,38 H11 A2,2 0 0 1 9,36 V35 A2,2 0 0 1 11,33 Z" />

    <!-- brazo izquierdo (cápsula) + puño verde, a juego con el puño de ic_biotec_hand_wave.xml -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M3.6,20 A1.4,1.4 0 0 1 5,21.4 V27.6 A1.4,1.4 0 0 1 3.6,29 A1.4,1.4 0 0 1 2.2,27.6 V21.4 A1.4,1.4 0 0 1 3.6,20 Z" />
    <path android:fillColor="#1B5E3C" android:pathData="M2.2,26.7 H5 V27.2 H2.2 Z" />

    <!-- brazo derecho (cápsula) + puño verde -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M22.4,20 A1.4,1.4 0 0 1 23.8,21.4 V27.6 A1.4,1.4 0 0 1 22.4,29 A1.4,1.4 0 0 1 21,27.6 V21.4 A1.4,1.4 0 0 1 22.4,20 Z" />
    <path android:fillColor="#1B5E3C" android:pathData="M21,26.7 H23.8 V27.2 H21 Z" />

    <!-- torso: bata de laboratorio -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M9,18.6 H17 A4,4 0 0 1 21,22.6 V29 A4,4 0 0 1 17,33 H9 A4,4 0 0 1 5,29 V22.6 A4,4 0 0 1 9,18.6 Z" />

    <!-- cuello en V de la bata -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1B5E3C"
        android:strokeWidth="1.1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M9,18.6 L13,24 L17,18.6" />

    <!-- insignia de pecho: aro fino + punto ámbar (antes solo el punto), eco de la antena -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F5A623"
        android:strokeWidth="0.35"
        android:pathData="M11.35,27 a1.65,1.65 0 1,0 3.3,0 a1.65,1.65 0 1,0 -3.3,0 Z" />
    <path
        android:fillColor="#F5A623"
        android:pathData="M11.7,27 a1.3,1.3 0 1,0 2.6,0 a1.3,1.3 0 1,0 -2.6,0 Z" />

    <!-- cinturón: un poco más grueso que antes, separación más marcada entre torso y base -->
    <path
        android:fillColor="#1B5E3C"
        android:pathData="M8,32.5 H18 A0.5,0.5 0 0 1 18.5,33 A0.5,0.5 0 0 1 18,33.5 H8 A0.5,0.5 0 0 1 7.5,33 A0.5,0.5 0 0 1 8,32.5 Z" />

    <!-- antena: bola un poco más grande + brillo, como la de los ojos -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12.3,2.6 H13.7 V5.6 H12.3 Z" />
    <path
        android:fillColor="#F5A623"
        android:pathData="M11.35,1.9 a1.65,1.65 0 1,0 3.3,0 a1.65,1.65 0 1,0 -3.3,0 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12.2,1.4 a0.4,0.4 0 1,0 0.8,0 a0.4,0.4 0 1,0 -0.8,0 Z" />

    <!-- cabeza (idéntica a ic_nexobio_robot.xml, desplazada +1 en X) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M7,5.6 H19 A3,3 0 0 1 22,8.6 V16.4 A3,3 0 0 1 19,19.4 H7 A3,3 0 0 1 4,16.4 V8.6 A3,3 0 0 1 7,5.6 Z" />

    <!-- ojo izquierdo + brillo -->
    <path
        android:fillColor="#1B5E3C"
        android:pathData="M7.65,11.6 a1.85,1.85 0 1,0 3.7,0 a1.85,1.85 0 1,0 -3.7,0 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M8.17,11.05 a0.58,0.58 0 1,0 1.16,0 a0.58,0.58 0 1,0 -1.16,0 Z" />

    <!-- ojo derecho + brillo -->
    <path
        android:fillColor="#1B5E3C"
        android:pathData="M14.65,11.6 a1.85,1.85 0 1,0 3.7,0 a1.85,1.85 0 1,0 -3.7,0 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M15.17,11.05 a0.58,0.58 0 1,0 1.16,0 a0.58,0.58 0 1,0 -1.16,0 Z" />

    <!-- sonrisa -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1B5E3C"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:pathData="M9.8,15.3 Q13,17.6 16.2,15.3" />
</vector>
